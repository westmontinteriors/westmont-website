---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; published?: Date; updated?: Date; }
const { title = SITE_TITLE, description = SITE_DESCRIPTION, image = '/westmont-social.png', type = 'website', published, updated } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'WESTMONT — Home & Interiors', url: Astro.site, description: SITE_DESCRIPTION };
const article = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, image: socialImage.href, mainEntityOfPage: canonical.href, datePublished: published?.toISOString(), dateModified: (updated || published)?.toISOString(), publisher: { '@type': 'Organization', name: 'WESTMONT — Home & Interiors', url: Astro.site } };
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#f7f5f0" />
<title>{title}</title>
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="The Journal — WESTMONT" href="/rss.xml" />
<meta property="og:site_name" content="WESTMONT — Home & Interiors" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={type === 'article' && image !== '/westmont-social.png' ? title : 'WESTMONT — Home & Interiors. Beautiful living, within reach.'} />
{type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === 'article' && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<script type="application/ld+json" set:html={JSON.stringify(type === 'article' ? article : website).replace(/</g, '\\u003c')} />
