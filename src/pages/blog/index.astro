---
import WestmontFooter from '../../components/WestmontFooter.astro';
import Seo from '../../components/Seo.astro';
import { getCollection } from 'astro:content';
import { STARTER_POSTS } from '../../consts';
const posts = (await getCollection('blog')).filter(post => !STARTER_POSTS.has(post.id)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [
  { id: 'all', label: 'All' },
  { id: 'living-rooms', label: 'Living Rooms' },
  { id: 'bedrooms', label: 'Bedrooms' },
  { id: 'styling-guides', label: 'Styling Guides' },
];
const editorial: Record<string, { category: string; summary: string }> = {
  'how-to-make-a-small-bedroom-feel-bigger': { category: 'bedrooms', summary: 'A little more breathing room, using the furniture you already own.' },
  'how-to-choose-the-right-rug-size-for-your-living-room': { category: 'living-rooms', summary: 'Simple measurements and three layouts for a room that feels connected.' },
  'how-to-hang-curtains-to-make-your-room-look-taller': { category: 'styling-guides', summary: 'The right height, width, and finishing details for a graceful frame.' },
  'how-to-make-your-bedroom-feel-like-a-boutique-hotel': { category: 'bedrooms', summary: 'Inviting layers and thoughtful touches for your everyday retreat.' },
  'how-to-make-a-neutral-living-room-feel-warm': { category: 'living-rooms', summary: 'Bring warmth to quiet colours with texture, wood, and softer light.' },
  'how-to-make-your-home-look-expensive': { category: 'styling-guides', summary: 'Considered changes that make a home feel beautifully put together.' },
};
const starter = posts.find(post => post.id === 'how-to-make-your-home-look-expensive');

---
<!doctype html>
<html lang="en">
  <head>
    <Seo title="The Journal | WESTMONT Home & Interiors" description="Design notes, thoughtful rooms, and affordable luxury home inspiration from WESTMONT." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">SKIP TO CONTENT</a>
    <div class="announcement">THE ART OF LIVING BEAUTIFULLY, FOR LESS</div>
    <header class="header">
      <a class="brand" href="/" aria-label="Westmont homepage">WESTMONT<span>HOME & INTERIORS</span></a>
      <nav aria-label="Main navigation"><a href="/#spaces">SPACES</a><a href="/blog/" aria-current="page">THE JOURNAL</a><a href="/curated-finds/">CURATED FINDS</a><a href="/about/">ABOUT</a></nav>
      <details class="mobile-menu"><summary aria-label="Open navigation"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href="/">HOME</a><a href="/#spaces">SPACES</a><a href="/blog/" aria-current="page">THE JOURNAL</a><a href="/curated-finds/">CURATED FINDS</a><a href="/about/">ABOUT</a></nav></details>
    </header>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      const toggle = menu?.querySelector('summary');
      if (menu && toggle) {
        menu.addEventListener('toggle', () => {
          toggle.setAttribute('aria-label', menu.open ? 'Close navigation' : 'Open navigation');
        });
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => { menu.open = false; });
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            toggle.focus();
          }
        });
        window.matchMedia('(max-width: 950px)').addEventListener('change', () => {
          menu.open = false;
        });
      }
    </script>
    <main id="main-content" class="journal-page">
      <section class="journal-intro">
        <p class="eyebrow">NOTES FROM WESTMONT</p>
        <h1>The <em>journal.</em></h1>
        <p class="journal-deck">Thoughtful ideas for a home that feels like you.</p>
      </section>
      <section class="journal-stories" aria-labelledby="latest-title">
        <div class="browse-bar">
          <nav class="category-tabs" aria-label="Browse stories by category">
            {categories.map(category => <a href={category.id === 'all' ? '/blog/' : `/blog/?category=${category.id}`} data-filter={category.id} aria-current={category.id === 'all' ? 'true' : undefined}>{category.label}</a>)}
          </nav>
          <p id="story-count" aria-live="polite" aria-atomic="true">{posts.length} stories</p>
        </div>
        {starter && <aside class="start-here" aria-label="Start here">
          <a href={`/blog/${starter.id}/`}>
            <img src={starter.data.heroImage} alt="" width="112" height="88" />
            <div><p class="eyebrow">START HERE</p><h2>A more elevated home, <em>within reach.</em></h2><p class="starter-description">Our guide to making your home look expensive without overspending.</p></div>
          </a>
        </aside>}
        <h2 id="latest-title" class="stories-title">Latest <em>stories.</em></h2>
        <div class="story-grid">
          {posts.map((post, index) => {
            const info = editorial[post.id] || { category: 'styling-guides', summary: post.data.description };
            return <article class="story" data-category={info.category}>
              <a href={`/blog/${post.id}/`}>
                {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} loading={index < 3 ? 'eager' : 'lazy'} width="640" height="400" />}
                <div class="story-copy"><p class="eyebrow">{categories.find(category => category.id === info.category)?.label}</p><h3>{post.data.title}</h3><p class="story-summary">{info.summary}</p><span class="story-read">READ THE STORY <span aria-hidden="true">↗</span></span></div>
              </a>
            </article>;
          })}
        </div>
      </section>
      <script>
        const filters = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-filter]'));
        const stories = Array.from(document.querySelectorAll<HTMLElement>('.story[data-category]'));
        const count = document.querySelector('#story-count');
        const title = document.querySelector('#latest-title');
        function applyCategory() {
          const requested = new URL(window.location.href).searchParams.get('category') || 'all';
          const category = filters.some(filter => filter.dataset.filter === requested) ? requested : 'all';
          filters.forEach(filter => {
            if (filter.dataset.filter === category) filter.setAttribute('aria-current', 'true');
            else filter.removeAttribute('aria-current');
          });
          stories.forEach(story => { story.hidden = category !== 'all' && story.dataset.category !== category; });
          const visible = stories.filter(story => !story.hidden).length;
          if (count) count.textContent = `${visible} ${visible === 1 ? 'story' : 'stories'}`;
          if (title) title.textContent = category === 'all' ? 'Latest stories.' : `${filters.find(filter => filter.dataset.filter === category)?.textContent}.`;
        }
        filters.forEach(filter => filter.addEventListener('click', event => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
          event.preventDefault();
          if (window.location.href !== filter.href) window.history.pushState({}, '', filter.href);
          applyCategory();
        }));
        window.addEventListener('popstate', applyCategory);
        applyCategory();
      </script>
      <section class="journal-note"><p class="eyebrow light-text">LUXURY IS A FEELING</p><h2>A home that feels like <em>you.</em></h2><p>Less about following every trend. More about finding what belongs.</p><a class="button button-outline" href="/#spaces">EXPLORE THE SPACES</a></section>
      <section class="newsletter"><div><p class="eyebrow">THE WESTMONT LETTER</p><h2>A little more <em>inspiration.</em></h2><p>Our newsletter is coming soon. In the meantime, we'd love to hear what's inspiring you.</p></div><a class="button button-dark" href="mailto:hello@westmontinteriors.com?subject=Westmont%20inquiry">GET IN TOUCH</a></section>
    </main>
    <WestmontFooter />
  </body>
</html>
<style is:global>
