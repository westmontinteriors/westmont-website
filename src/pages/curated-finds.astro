0px;margin:auto}.intro h2,.section-heading h2,.newsletter h2{font-size:clamp(42px,5vw,72px);line-height:1.22;letter-spacing:-.035em}.intro h2{margin-bottom:26px}.intro>p:not(.eyebrow){max-width:630px;margin:0 auto 30px;color:#74796f;font-size:15px;line-height:1.9}.underlined-link{display:inline-flex;align-items:center;gap:25px;border-bottom:1px solid;padding-bottom:10px;font-size:10px;letter-spacing:.12em;font-weight:700}.underlined-link span{font-size:18px}.section{padding:100px 6%;max-width:1500px;margin:auto}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:38px}.section-heading h2{margin-bottom:0}.side-label{font-size:10px;letter-spacing:.14em;color:#8b9186;padding-bottom:10px}.room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.room-image{overflow:hidden;aspect-ratio:3/4}.room-image img{height:100%;transition:transform .45s}.room-card:hover img{transform:scale(1.045)}.room-caption{color:#84897f;font-size:10px;letter-spacing:.08em;margin:20px 0 9px}.room-card h3{font-size:30px;display:flex;align-items:center;justify-content:space-between}.room-card h3 span{font-family:'DM Sans',sans-serif;font-size:22px}.statement{background:#30372e;color:#fff;text-align:center;padding:130px 20px}.statement h2{font-size:clamp(42px,5vw,74px);line-height:1.24;margin-bottom:28px}.statement>p:not(.eyebrow){max-width:540px;color:#d4d8cf;margin:0 auto 32px;line-height:1.9;font-size:15px}.button-outline{border:1px solid #dfe3db}.article-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.article-grid article>img{aspect-ratio:1.55;margin-bottom:26px}.article-grid .eyebrow{margin-bottom:14px}.article-grid h3{font-size:31px;margin-bottom:13px}.article-grid article>p:last-child{font-size:14px;color:#757a70;line-height:1.8}.newsletter{background:#e9e9e2;padding:90px 6%;display:flex;justify-content:space-between;align-items:center;gap:35px}.newsletter h2{margin-bottom:16px}.newsletter p:last-child{font-size:14px;color:#72786e;line-height:1.8}.button-dark{background:#30372e;color:white;white-space:nowrap}footer{padding:65px 6% 25px}.footer-top,.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:25px}.footer-top p{font-family:'Playfair Display',serif;font-style:italic;color:#777f72;font-size:20px}.footer-bottom{border-top:1px solid #ddd;margin-top:55px;padding-top:22px;color:#8b9086;font-size:9px;letter-spacing:.14em}@media(max-width:950px){.header nav{display:none}.room-grid{gap:15px}}@media(max-width:650px){.header{height:78px}.brand{font-size:22px}.nav-end{font-size:9px}.hero{height:78vh;min-height:610px}.hero-content{margin:0 7%}.hero h1{font-size:clamp(52px,12vw,78px)}.hero-caption{font-size:8px}.intro{padding:85px 6%}.section{padding:75px 6%}.side-label{display:none}.room-grid,.article-grid{grid-template-columns:1fr;gap:30px}.room-image{aspect-ratio:4/4.3}.statement{padding:95px 7%}.newsletter{padding:75px 7%;display:block}.newsletter .button{margin-top:15px}.footer-top,.footer-bottom{align-items:flex-start;flex-direction:column}.footer-top p{margin-top:18px}.footer-bottom{line-height:1.8}}
</style>

<style is:global>
/* WESTMONT navigation: understated editorial styling */
.header nav a{position:relative;padding:12px 0;transition:color .2s ease}.header nav a::after{content:'';position:absolute;bottom:5px;left:0;width:0;height:1px;background:currentColor;transition:width .25s ease}.header nav a:hover::after,.header nav a:focus-visible::after{width:100%}.header nav a:hover{color:#777f70}.mobile-menu{display:none}.mobile-menu summary{list-style:none;cursor:pointer;padding:16px 8px;min-width:44px;min-height:44px;display:flex;flex-direction:column;justify-content:center;gap:6px}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:25px;height:1px;background:#292d27}.mobile-menu[open] summary span:first-child{transform:translateY(3.5px) rotate(45deg)}.mobile-menu[open] summary span:last-child{transform:translateY(-3.5px) rotate(-45deg)}@media(max-width:950px){.mobile-menu{display:block}.mobile-menu nav{display:none;position:absolute;z-index:50;top:100%;left:0;right:0;background:#f7f5f0;padding:30px 7% 44px;flex-direction:column;gap:10px;box-shadow:0 18px 30px rgba(0,0,0,.09)}.mobile-menu[open] nav{display:flex}.header{position:relative;z-index:20}.mobile-menu nav a{font-size:12px;letter-spacing:.16em;padding:15px 0;border-bottom:1px solid #e2e1d9}}@media(prefers-reduced-motion:reduce){.header nav a,.header nav a::after{transition:none}}
</style>

<style is:global>
.header nav a[aria-current="page"]::after{width:100%}.finds-page{margin:0;padding:0}.finds-intro{text-align:center;padding:85px 7% 55px}.finds-intro h1{font-size:clamp(60px,8vw,108px);line-height:1.1;letter-spacing:-.045em;margin-bottom:26px}.finds-deck{font-family:'Playfair Display',Georgia,serif;font-size:26px;margin-bottom:18px}.finds-description{max-width:650px;margin:auto;color:#74796f;font-size:15px;line-height:1.9}.category-nav{display:flex;justify-content:center;flex-wrap:wrap;gap:14px 36px;padding:24px 7%;border-top:1px solid #e2e1d9;border-bottom:1px solid #e2e1d9}.category-nav a{font-size:10px;letter-spacing:.16em;text-transform:uppercase;padding:8px 0}.category-nav a:hover{text-decoration:underline;text-underline-offset:7px}.affiliate-note{padding:25px 7% 35px;max-width:1000px;margin:auto;text-align:center}.affiliate-note p{font-size:11px;line-height:1.8;color:#74796f;margin-bottom:6px}.finds-welcome{max-width:1320px;margin:15px auto 30px;padding:0 6%;display:grid;grid-template-columns:1fr 1.15fr}.finds-welcome>div{background:#e9e9e2;padding:55px 12%;display:flex;flex-direction:column;justify-content:center}.finds-welcome h2{font-size:clamp(36px,4vw,55px);line-height:1.2;letter-spacing:-.035em;margin-bottom:24px}.finds-welcome p:not(.eyebrow){font-size:14px;line-height:1.9;color:#74796f}.finds-welcome>img{height:100%;min-height:380px}.finds-collections{max-width:1320px;margin:auto;padding:0 6% 75px}.finds-category{padding-top:65px;scroll-margin-top:25px}.finds-category .section-heading h2{font-size:clamp(38px,4vw,54px)}.category-preview{display:grid;grid-template-columns:1fr 1.5fr;background:#eeeee7}.category-preview>img{height:260px}.category-preview>div{padding:35px 9%;align-self:center}.category-preview h3{font-size:30px;line-height:1.3;margin-bottom:16px}.category-preview p:not(.eyebrow){font-size:14px;line-height:1.8;color:#74796f;margin-bottom:0}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px 28px}.product-image{display:block;background:#e9e9e2;overflow:hidden;margin-bottom:23px}.product-image img{aspect-ratio:4/5;transition:transform .3s}.product-image:hover img{transform:scale(1.025)}.product-card .eyebrow{font-size:9px;margin-bottom:13px}.product-card h3{font-size:28px;line-height:1.25;margin-bottom:15px}.product-description{font-size:14px;line-height:1.8;color:#74796f}.price-label{font-size:12px;color:#565e50}.product-card .underlined-link{font-size:9px;line-height:1.7}.finds-note{text-align:center;background:#30372e;color:#f7f5f0;padding:85px 7%}.finds-note h2{font-size:clamp(38px,5vw,60px);line-height:1.2;margin-bottom:25px}.finds-note>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#d4d8cf;margin-bottom:30px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}a:focus-visible,summary:focus-visible{outline:2px solid #777f70;outline-offset:5px}@media(max-width:950px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.finds-welcome>div{padding:40px 10%}}@media(max-width:650px){.finds-intro{padding:60px 7% 40px}.finds-deck{font-size:23px}.category-nav{gap:12px 22px}.finds-welcome{padding:0 7%;grid-template-columns:1fr}.finds-welcome>img{min-height:0;height:auto;aspect-ratio:4/3}.finds-welcome>div{padding:40px 9%}.finds-collections{padding:0 7% 60px}.finds-category{padding-top:45px}.category-preview{grid-template-columns:1fr}.category-preview>img{height:auto;aspect-ratio:16/9}.category-preview>div{padding:30px 9% 36px}.category-preview h3{font-size:28px}.product-grid{grid-template-columns:1fr;gap:40px}.product-image img{aspect-ratio:1}.finds-note{padding:65px 7%}}@media(prefers-reduced-motion:reduce){.product-image img{transition:none}html{scroll-behavior:auto}}
</style>

<style is:global>
.skip-link{position:fixed;top:8px;left:8px;z-index:100;background:#30372e;color:#f7f5f0;padding:16px;font-size:12px;transform:translateY(-180%)}.skip-link:focus{transform:none}a:focus-visible,summary:focus-visible{outline:2px solid #777f70;outline-offset:5px}
</style>
