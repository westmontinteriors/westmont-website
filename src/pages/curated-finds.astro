---
import Seo from '../components/Seo.astro';
import { z } from 'astro:content';
const categories = ['Furniture', 'Lighting', 'Rugs', 'Decor', 'Wall Art'] as const;
const productSchema = z.object({
  title: z.string().min(1),
  description: z.string().min(1),
  image: z.string().refine(value => /^\/(?!\/)/.test(value) || /^https:\/\//.test(value)),
  imageAlt: z.string().min(1),
  category: z.enum(categories),
  retailer: z.string().min(1),
  affiliateUrl: z.string().url().refine(value => new URL(value).protocol === 'https:'),
  priceLabel: z.string().optional(),
  published: z.boolean().default(false),
});
const entries = import.meta.glob('../content/products/**/*.json', { eager: true, import: 'default' });
const products = Object.entries(entries).flatMap(([filename, data]) => {
  if (!(data && typeof data === 'object' && 'published' in data && data.published === true)) return [];
  const parsed = productSchema.safeParse(data);
  if (!parsed.success) throw new Error(`Invalid published Curated Find in ${filename}: ${parsed.error.message}`);
  return [parsed.data];
});
const slug = (category: string) => category.toLowerCase().replaceAll(' ', '-');
const categoryImages: Record<string, string> = {
  Furniture: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1000&q=85',
  Lighting: 'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1000&q=85',
  Rugs: 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=1000&q=85',
  Decor: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1000&q=85',
  'Wall Art': 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&fit=crop&w=1000&q=85',
};
---
<!doctype html>
<html lang="en">
  <head>
    <Seo title="Curated Finds | WESTMONT Home & Interiors" description="Thoughtfully chosen furniture, lighting, rugs, decor, and wall art. Discover attainable luxury with WESTMONT Curated Finds." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">SKIP TO CONTENT</a>
    <div class="announcement">THE ART OF LIVING BEAUTIFULLY, FOR LESS</div>
    <header class="header">
      <a class="brand" href="/" aria-label="Westmont homepage">WESTMONT<span>HOME & INTERIORS</span></a>
      <nav aria-label="Main navigation"><a href="/#spaces">SPACES</a><a href="/blog/">THE JOURNAL</a><a href="/curated-finds/" aria-current="page">CURATED FINDS</a><a href="/about/">ABOUT</a></nav>
      <details class="mobile-menu"><summary aria-label="Open navigation"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href="/">HOME</a><a href="/#spaces">SPACES</a><a href="/blog/">THE JOURNAL</a><a href="/curated-finds/" aria-current="page">CURATED FINDS</a><a href="/about/">ABOUT</a></nav></details>
    </header>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      const toggle = menu?.querySelector('summary');
      if (menu && toggle) {
        menu.addEventListener('toggle', () => {
          toggle.setAttribute('aria-label', menu.open ? 'Close navigation' : 'Open navigation');
        });
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => { menu.open = false; });
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            toggle.focus();
          }
        });
        window.matchMedia('(max-width: 950px)').addEventListener('change', () => {
          menu.open = false;
        });
      }
    </script>
    <main id="main-content" class="finds-page">
      <section class="finds-intro"><p class="eyebrow">CHOSEN WITH INTENTION</p><h1>Curated <em>finds.</em></h1><p class="finds-deck">Thoughtful pieces. Beautiful possibilities.</p><p class="finds-description">Furniture, lighting, and finishing touches selected for their enduring style and approachable price. A considered collection for a home that feels like you.</p></section>
      <nav class="category-nav" aria-label="Browse product categories">{categories.map(category => <a href={`#${slug(category)}`}>{category}</a>)}</nav>
      <div class="affiliate-note"><p>Some links on this page may be affiliate links. If you buy through them, WESTMONT may earn a commission at no additional cost to you.</p><p>Prices and availability can change. Check the retailer for current details.</p></div>
      {products.length === 0 && <section class="finds-welcome"><div><p class="eyebrow">A COLLECTION IN THE MAKING</p><h2>Good things are<br /><em>worth choosing well.</em></h2><p>Our first selections are coming soon. Explore the categories below for a glimpse of what we're looking for.</p></div><img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1500&q=85" alt="A warm neutral living room with natural textures" fetchpriority="high" /></section>}
      <div class="finds-collections">{categories.map(category => { const selection = products.filter(product => product.category === category); return <section class="finds-category" id={slug(category)} aria-labelledby={`${slug(category)}-title`}><div class="section-heading"><div><p class="eyebrow">THE CONSIDERED HOME</p><h2 id={`${slug(category)}-title`}>{category}</h2></div><span class="side-label">{selection.length > 0 ? `${selection.length} ${selection.length === 1 ? 'SELECTED FIND' : 'SELECTED FINDS'}` : 'COMING SOON'}</span></div>{selection.length > 0 ? <div class="product-grid">{selection.map(product => <article class="product-card"><a class="product-image" href={product.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer" aria-label={`${product.title} at ${product.retailer} (opens in a new tab)`}><img src={product.image} alt={product.imageAlt} loading="lazy" /></a><p class="eyebrow">{product.retailer}</p><h3>{product.title}</h3><p class="product-description">{product.description}</p>{product.priceLabel && <p class="price-label">{product.priceLabel}</p>}<a class="underlined-link" href={product.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer">VIEW AT {product.retailer.toUpperCase()}<span class="sr-only"> (opens in a new tab)</span></a></article>)}</div> : <div class="category-preview"><img src={categoryImages[category]} alt={`${category} inspiration in a neutral home interior`} loading="lazy" /><div><p class="eyebrow">OUR FIRST FINDS ARE COMING SOON</p><h3>{category === 'Furniture' ? 'Pieces to build a room around.' : category === 'Lighting' ? 'A warmer way to see your space.' : category === 'Rugs' ? 'Texture from the ground up.' : category === 'Decor' ? 'The details that make it personal.' : 'A finishing touch with a point of view.'}</h3><p>We're choosing our first {category.toLowerCase()} finds with care. Check back for considered recommendations.</p></div></div>}</section>})}</div>
      <section class="finds-note"><p class="eyebrow light-text">MORE THAN A SHOPPING LIST</p><h2>Bring the whole room <em>together.</em></h2><p>Discover the ideas behind a more considered home in The Journal.</p><a class="button button-outline" href="/blog/">EXPLORE THE JOURNAL</a></section>
    </main>
    <footer><div class="footer-top"><a class="brand" href="/">WESTMONT<span>HOME & INTERIORS</span></a><p>Beautiful living, within reach.</p></div><div class="footer-bottom"><span>© {new Date().getFullYear()} WESTMONT. ALL RIGHTS RESERVED.</span><span>INTERIORS · INSPIRATION · INTENTION</span></div></footer>
  </body>
</html>
<style is:global>
